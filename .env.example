# Copy to .env and fill in. Never commit .env.
PORT=8787

# viaSocket — backend only. VIASOCKET_EMBED_SECRET comes from the viaSocket dashboard.
VIASOCKET_EMBED_SECRET=
VIASOCKET_ORG_ID=71203
VIASOCKET_PROJECT_ID=projKWM019jX
VIASOCKET_API_URL=https://flow-api.viasocket.com

# The viaSocket unique_identifier for the app's single local user. Replace with the
# signed-in user's id once the app has accounts. Never change it for an existing user.
VIASOCKET_USER_ID=local-user

# Daily digest (server/digest.mjs). Pending tasks are emailed at local midnight through
# the Gmail account connected on the Integrations page. Defaults to that account's own address.
# DIGEST_EMAIL=you@example.com
